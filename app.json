{
  "expo": {
    "name": "Charlie",
    "slug": "charlie-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "charlie",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1628"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.getcharlie.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "co.getcharlie.app"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "f10b929b-f223-4b1b-9d2a-dc62b141a027"
      },
      "router": {
        "origin": false
      }
    },
    "owner": "alexwrdev",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f10b929b-f223-4b1b-9d2a-dc62b141a027"
    }
  }
}
